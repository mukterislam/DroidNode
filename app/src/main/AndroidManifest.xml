<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for local Node.js HTTP server & npm registry downloads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage permissions to access /sdcard/www -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Android 11+ (API 30+) All Files Access to freely access /sdcard/www -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Keeps CPU running when app goes to background -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground Service permissions (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 14+ (API 34) Foreground Service Types -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Post Notifications for ongoing server status (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="DroidNode"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidNode"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic="true" is required to allow Android WebView or local HTTP
             clients to communicate with http://127.0.0.1:8080 without enforcing HTTPS -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Service Declaration -->
        <service
            android:name=".service.NodeServerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <!-- Property required by Google Play for specialUse foreground services -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Embedded Node.js Web Server Runtime Engine" />
        </service>

    </application>

</manifest>
